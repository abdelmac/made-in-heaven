# Public Supabase credentials are intentionally browser-safe; use project values.
NEXT_PUBLIC_SUPABASE_URL=
# Preferred publishable key, or the legacy anon key below. Set one, not both.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix this key with NEXT_PUBLIC_ or commit its value.
SUPABASE_SERVICE_ROLE_KEY=
# Canonical origin; HTTPS for deployment, HTTP localhost for development.
# Current hosted app: https://solace-hikmagitz.vercel.app (set this in Vercel Production).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional team invitation emails. Server-only; no send occurs unless an owner/admin
# explicitly selects email delivery. Requires a verified Resend sending domain.
# Use a plain address (no display name), e.g. invitations@your-verified-domain.com.
# Email delivery also requires NEXT_PUBLIC_APP_URL to be the canonical HTTPS origin.
RESEND_API_KEY=
INVITATION_EMAIL_FROM=

# TEST MODE ONLY: sk_test_... (live keys/events are deliberately rejected).
STRIPE_SECRET_KEY=
# Stripe CLI prints whsec_... after `stripe listen` (local secret differs from deployment).
STRIPE_WEBHOOK_SECRET=
# Actual active, licensed, per-unit recurring Prices. Each key must be distinct.
# Initial offering: Solace Pro, EUR 1.00/month (100 minor units), sandbox only.
# Leave yearly and Team IDs unset for this first checkout verification.
STRIPE_PRO_MONTH_PRICE_ID=
STRIPE_PRO_YEAR_PRICE_ID=
STRIPE_TEAM_MONTH_PRICE_ID=
STRIPE_TEAM_YEAR_PRICE_ID=
# Separate test Customer Portal configurations restrict plan switches per scope.
# Required before checkout: invoice history + payment-method updates + cancellation
# at period end enabled; quantity changes off. See docs/billing.md for activation.
STRIPE_PRO_PORTAL_CONFIGURATION_ID=
STRIPE_TEAM_PORTAL_CONFIGURATION_ID=

# Hosted Stripe Checkout needs no browser publishable key. Keep all STRIPE_ keys
# server-only. Changing to a live key alone intentionally does not activate payments.

# Limits, grace days, and optional trial entitlement policy are configured in the
# server-owned billing_policy database row via a migration; see docs/billing.md.
