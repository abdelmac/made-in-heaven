# Public Supabase credentials are browser-safe; use values from one project.
NEXT_PUBLIC_SUPABASE_URL=
# Set one public key, not both.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never commit credentials or prefix them with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Canonical origin; HTTPS for deployment, HTTP localhost for development.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional invitation emails; requires a verified Resend sending domain.
# Account confirmation/recovery uses Supabase Auth SMTP separately.
RESEND_API_KEY=
INVITATION_EMAIL_FROM=

# Safe default: test. A live key alone NEVER opens real checkout.
STRIPE_BILLING_MODE=test
STRIPE_ACCOUNT_ID=
STRIPE_SECRET_KEY=
# whsec_... from the endpoint in this SAME mode/account.
# Local Stripe CLI and hosted endpoints have different signing secrets.
STRIPE_WEBHOOK_SECRET=
# Current approved reference offer: EUR 1/month (100 cents), no annual offer.
# Actual active, flat, licensed recurring Price IDs; no fallback prices.
STRIPE_PRO_MONTH_PRICE_ID=
# Leave empty: no annual offer is approved for the first release.
STRIPE_PRO_YEAR_PRICE_ID=
# Team is not part of the launch. Leave these empty.
STRIPE_TEAM_MONTH_PRICE_ID=
STRIPE_TEAM_YEAR_PRICE_ID=
# Portal: invoices, payment-method updates and cancellation at period end.
# No quantity changes. Optional price changes must stay within each tier.
STRIPE_PRO_PORTAL_CONFIGURATION_ID=
STRIPE_TEAM_PORTAL_CONFIGURATION_ID=

# Live checkout remains CLOSED unless every gate is true and seller information
# is valid. These are operator attestations, not automated compliance checks.
# Keep closed until docs/launch-runbook.md has been completed and reviewed.
STRIPE_LIVE_CHECKOUT_ENABLED=false
SOLACE_COMMERCIAL_HOSTING_CONFIRMED=false
SOLACE_AUTH_EMAIL_VERIFIED=false
SOLACE_LAUNCH_REVIEWED=false

# Real seller information only; never invent details or commit personal data.
# Policy URLs must be public HTTPS URLs. Draft routes are /legal /privacy /terms.
# See docs/launch-content.md before using those routes as published policies.
SOLACE_SELLER_NAME=
SOLACE_SELLER_ADDRESS=
SOLACE_SELLER_REGISTRATION=
SOLACE_SUPPORT_EMAIL=
SOLACE_LEGAL_NOTICE_URL=
SOLACE_PRIVACY_POLICY_URL=
SOLACE_TERMS_URL=

# Optional public brand, separate from legal seller identity.
SOLACE_PUBLISHER_NAME=
SOLACE_PUBLISHER_COUNTRY=

# Native Apple/Google billing: server-only, separate from Stripe.
# Keep disabled until store products, credentials and sandbox verification exist.
NATIVE_BILLING_ENVIRONMENT=sandbox
NATIVE_LIVE_PURCHASES_ENABLED=false
APPLE_IAP_ENABLED=false
APPLE_IAP_APP_ID=
APPLE_IAP_PRODUCT_ID=
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_PRIVATE_KEY=
GOOGLE_IAP_ENABLED=false
GOOGLE_IAP_PRODUCT_ID=
GOOGLE_IAP_BASE_PLAN_ID=
GOOGLE_IAP_SERVICE_ACCOUNT_JSON=
GOOGLE_IAP_PUSH_AUDIENCE=
GOOGLE_IAP_PUSH_SERVICE_ACCOUNT=
# Required for the prepared Pro hourly reconciliation job, minimum 32 characters.
CRON_SECRET=

# Hosted Checkout needs NO browser Stripe key. All STRIPE_ variables stay private.
# Migration 0011 binds billing to one mode/account; switching an occupied database
# is refused. A reviewed, empty live database is required for an isolated launch.
